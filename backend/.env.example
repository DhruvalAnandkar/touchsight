# Copy to .env in this folder if you want keys or different tactile constants.
# Docker Compose reads this file for ${VAR} substitution. The app also has defaults,
# so `docker compose up --build` works with no .env at all.

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- tactile page ---
PAGE_SIZE=letter
DPI=120
MARGIN_MM=12.7
MIN_STROKE_MM=1.5
MIN_GAP_MM=2.5
MIN_AREA_MM2=40
EPSILON_MM=0.55
MAX_REGIONS=8

# --- SAM 2 (optional). OpenCV runs when this is empty or the call fails. ---
SAM_API_TOKEN=
SAM_MODEL=meta/sam-2
SAM_API_BASE=https://api.replicate.com/v1
SAM_TIMEOUT_S=30

# --- vision labels (optional). Samples use samples/labels.json when this is empty. ---
# Gemini uses the OpenAI-compatible endpoint: set VLM_PROVIDER=openai and put that URL in VLM_BASE_URL.
# VLM_MODEL is a comma-separated preference list. On HTTP 429 or a quota error the next model is tried immediately.
VLM_PROVIDER=
VLM_MODEL=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash
VLM_BASE_URL=
VLM_API_KEY=
ANTHROPIC_API_KEY=
# Explore questions. This key calls api.openai.com and is never sent to the browser.
# If it is empty, questions use the vision key and VLM_BASE_URL instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANSWER_MODEL=gpt-4o-mini
DEPTH_API_TOKEN=
RELIEF_MAX_MM=150
